<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista List -->
    <record id="view_property_type_list" model="ir.ui.view">
        <field name="name">real.estate.property.type.list</field>
        <field name="model">real.estate.property.type</field>
        <field name="arch" type="xml">
            <list string="Tipos de Propiedad">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Vista Form Simple -->
    <record id="view_property_type_form" model="ir.ui.view">
        <field name="name">real.estate.property.type.form</field>
        <field name="model">real.estate.property.type</field>
        <field name="arch" type="xml">
            <form string="Tipo de Propiedad">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción -->
    <record id="action_property_type" model="ir.actions.act_window">
        <field name="name">Tipos de Propiedad</field>
        <field name="res_model">real.estate.property.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
