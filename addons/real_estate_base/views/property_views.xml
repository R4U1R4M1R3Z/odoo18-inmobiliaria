<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================== -->
    <!-- VISTA LIST                                    -->
    <!-- ============================================== -->
    <record id="view_property_list" model="ir.ui.view">
        <field name="name">real.estate.property.list</field>
        <field name="model">real.estate.property</field>
        <field name="arch" type="xml">
            <list string="Propiedades" 
                  multi_edit="1"
                  decoration-muted="state == 'draft'"
                  decoration-success="state == 'available'"
                  decoration-warning="state == 'reserved'"
                  decoration-danger="state in ['sold', 'rented']">
                <header>
                    <button name="action_set_available" string="Publicar" type="object" class="btn-primary"/>
                </header>
                <field name="reference" string="Ref." optional="show"/>
                <field name="name" string="Inmueble"/>
                <field name="property_type_id" string="Tipo" optional="show"/>
                <field name="city"/>
                <field name="operation_type" string="Operación" widget="badge"
                       decoration-info="operation_type == 'rent'"
                       decoration-primary="operation_type == 'sale'"
                       decoration-warning="operation_type == 'both'"/>
                <field name="surface" string="m²"/>
                <field name="rooms" string="Hab"/>
                <field name="bathrooms" string="Baños"/>
                <field name="sale_price" string="Venta (€)" optional="show"/>
                <field name="rent_price" string="Alquiler (€)" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'available'"
                       decoration-warning="state == 'reserved'"
                       decoration-danger="state in ['sold', 'rented']"
                       decoration-muted="state == 'draft'"/>
                <field name="agent_id" widget="many2one_avatar_user" string="Agente" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ============================================== -->
    <!-- VISTA FORM                                    -->
    <!-- ============================================== -->
    <record id="view_property_form" model="ir.ui.view">
        <field name="name">real.estate.property.form</field>
        <field name="model">real.estate.property</field>
        <field name="arch" type="xml">
            <form string="Propiedad">
                <header>
                    <button name="action_set_available" string="✓ Publicar" type="object" 
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_set_reserved" string="⏸ Reservar" type="object" 
                            class="btn-warning" invisible="state != 'available'"/>
                    <button name="action_cancel" string="↶ Despublicar" type="object" 
                            invisible="state != 'available'"/>
                    <button name="action_set_sold" string="✓ Vendido" type="object" 
                            class="btn-success"
                            invisible="state != 'reserved' or operation_type not in ['sale', 'both']"
                            confirm="¿Confirmar venta?"/>
                    <button name="action_set_rented" string="✓ Alquilado" type="object" 
                            class="btn-success"
                            invisible="state != 'reserved' or operation_type not in ['rent', 'both']"
                            confirm="¿Confirmar alquiler?"/>
                    <button name="action_back_to_available" string="↶ Liberar" type="object" 
                            invisible="state != 'reserved'"/>
                    <button name="action_set_available" string="↻ Republicar" type="object" 
                            class="btn-secondary" invisible="state not in ['sold', 'rented']"
                            confirm="¿Volver a publicar?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,available,reserved,sold,rented"/>
                </header>
                
                <sheet>
                    <!-- Ribbons -->
                    <widget name="web_ribbon" title="VENDIDO" bg_color="text-bg-danger" invisible="state != 'sold'"/>
                    <widget name="web_ribbon" title="ALQUILADO" bg_color="text-bg-info" invisible="state != 'rented'"/>
                    <widget name="web_ribbon" title="RESERVADO" bg_color="text-bg-warning" invisible="state != 'reserved'"/>
                    
                    <!-- Smart buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_images" type="object" class="oe_stat_button" icon="fa-images">
                            <field name="image_count" widget="statinfo" string="Fotos"/>
                        </button>
                    </div>
                    
                    <!-- Avatar imagen -->
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_1920'}"/>
                    
                    <!-- Título principal -->
                    <div class="oe_title">
                        <label for="name" string="Título del anuncio"/>
                        <h1><field name="name" placeholder="Ej: Espectacular ático con vistas al mar" required="1"/></h1>
                    </div>
                    
                    <!-- Badges de info -->
                    <div class="d-flex align-items-center flex-wrap gap-2 mb-4">
                        <span class="badge text-bg-secondary px-3 py-2 fs-6">
                            <i class="fa fa-hashtag me-1"/>
                            <field name="reference" readonly="1"/>
                        </span>
                        <field name="property_type_id" widget="badge" decoration-info="1"
                               options="{'no_create': True, 'no_open': True}"/>
                        <field name="operation_type" widget="badge"
                               decoration-primary="operation_type == 'sale'"
                               decoration-success="operation_type == 'rent'"
                               decoration-warning="operation_type == 'both'"/>
                    </div>
                    
                    <!-- Panel de precio y características -->
                    <div class="row mb-4">
                        <!-- Columna de precios -->
                        <div class="col-lg-5 mb-3 mb-lg-0">
                            <div class="card border-0 bg-light h-100">
                                <div class="card-body">
                                    
                                    <!-- Precio venta -->
                                    <div invisible="operation_type == 'rent'" class="mb-3">
                                        <small class="text-uppercase text-muted fw-bold d-block mb-2">
                                            Precio de venta
                                        </small>
                                        <div class="d-flex align-items-baseline text-primary fw-bold" style="font-size: 32px; line-height: 1;">
                                            <field name="sale_price" nolabel="1" style="width: 250px !important;"/> <span class="ms-1">€</span>
                                        </div>
                                        <div class="text-muted small mt-1" invisible="price_per_sqm == 0">
                                            <field name="price_per_sqm" nolabel="1"/> € por m²
                                        </div>
                                    </div>
                                    
                                    <!-- Precio alquiler -->
                                    <div invisible="operation_type == 'sale'">
                                        <small class="text-uppercase text-muted fw-bold d-block mb-2">
                                            Alquiler mensual
                                        </small>
                                        <div class="d-flex align-items-baseline text-success fw-bold" style="font-size: 32px; line-height: 1;">
                                            <field name="rent_price" nolabel="1" style="width: 200px !important;"/> <span class="ms-1">€</span><span class="text-muted fs-6 fw-normal">/mes</span>
                                        </div>
                                    </div>
                                    
                                    <!-- Gastos -->
                                    <div class="border-top mt-3 pt-3">
                                        <div class="row small">
                                            <div class="col-6">
                                                <span class="text-muted">Comunidad:</span><br/>
                                                <strong><field name="community_fees" nolabel="1"/> €/mes</strong>
                                            </div>
                                            <div class="col-6">
                                                <span class="text-muted">IBI:</span><br/>
                                                <strong><field name="ibi" nolabel="1"/> €/año</strong>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Columna de características -->
                        <div class="col-lg-7">
                            <div class="card border-0 bg-light h-100">
                                <div class="card-body">
                                    <div class="row text-center">
                                        <div class="col-3 border-end">
                                            <i class="fa fa-2x fa-expand text-primary mb-2 d-block"/>
                                            <h4 class="mb-0"><field name="surface" nolabel="1"/></h4>
                                            <small class="text-muted">m²</small>
                                        </div>
                                        <div class="col-3 border-end">
                                            <i class="fa fa-2x fa-bed text-primary mb-2 d-block"/>
                                            <h4 class="mb-0"><field name="rooms" nolabel="1"/></h4>
                                            <small class="text-muted">Hab.</small>
                                        </div>
                                        <div class="col-3 border-end">
                                            <i class="fa fa-2x fa-bath text-primary mb-2 d-block"/>
                                            <h4 class="mb-0"><field name="bathrooms" nolabel="1"/></h4>
                                            <small class="text-muted">Baños</small>
                                        </div>
                                        <div class="col-3">
                                            <i class="fa fa-2x fa-building text-primary mb-2 d-block"/>
                                            <h4 class="mb-0"><field name="floor" nolabel="1"/>ª</h4>
                                            <small class="text-muted">Planta</small>
                                        </div>
                                    </div>
                                    
                                    <!-- Extras -->
                                    <div class="border-top mt-3 pt-3">
                                        <div class="d-flex flex-wrap gap-2 justify-content-center">
                                            <span class="badge rounded-pill text-bg-light border px-3 py-2" invisible="not elevator">
                                                <i class="fa fa-arrow-up me-1"/>Ascensor
                                            </span>
                                            <span class="badge rounded-pill text-bg-light border px-3 py-2" invisible="not garage">
                                                <i class="fa fa-car me-1"/>Garaje
                                            </span>
                                            <span class="badge rounded-pill text-bg-light border px-3 py-2" invisible="not terrace">
                                                <i class="fa fa-sun-o me-1"/>Terraza
                                            </span>
                                            <span class="badge rounded-pill text-bg-light border px-3 py-2" invisible="not piscina">
                                                <i class="fa fa-tint me-1"/>Piscina
                                            </span>
                                            <span class="badge rounded-pill text-bg-light border px-3 py-2" invisible="not ac">
                                                <i class="fa fa-snowflake-o me-1"/>A/A
                                            </span>
                                            <span class="badge rounded-pill text-bg-light border px-3 py-2" invisible="not furnished">
                                                <i class="fa fa-home me-1"/>Amueblado
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Info en 2 columnas -->
                    <group>
                        <group string="Datos del inmueble">
                            <field name="operation_type" widget="radio" options="{'horizontal': true}"/>
                            <field name="condition" widget="radio" options="{'horizontal': true}"/>
                            <field name="year_built" placeholder="Ej: 2005"/>
                            <field name="last_renovation" placeholder="Año reforma"/>
                            <field name="total_floors"/>
                            <field name="energy_certificate" widget="badge"
                                   decoration-success="energy_certificate in ['A', 'B']"
                                   decoration-info="energy_certificate == 'C'"
                                   decoration-warning="energy_certificate in ['D', 'E']"
                                   decoration-danger="energy_certificate in ['F', 'G']"/>
                        </group>
                        <group string="Ubicación">
                            <field name="street" placeholder="Calle, número..."/>
                            <field name="city"/>
                            <field name="zip"/>
                            <field name="agent_id" widget="many2one_avatar_user"/>
                        </group>
                    </group>
                    
                    <!-- Pestañas -->
                    <notebook>
                        <page string="Características" name="features">
                            <group>
                                <group string="Superficies">
                                    <field name="surface_plot" string="Parcela (m²)"/>
                                    <field name="terrace"/>
                                    <field name="terrace_surface" invisible="not terrace" string="Terraza (m²)"/>
                                </group>
                                <group string="Equipamiento">
                                    <field name="elevator" widget="boolean_toggle"/>
                                    <field name="garage" widget="boolean_toggle"/>
                                    <field name="garage_spaces" invisible="not garage"/>
                                    <field name="storage" widget="boolean_toggle" string="Trastero"/>
                                    <field name="piscina" widget="boolean_toggle" string="Piscina"/>
                                    <field name="garden" widget="boolean_toggle" string="Jardín"/>
                                </group>
                            </group>
                            <group>
                                <group string="Climatización">
                                    <field name="heating" widget="boolean_toggle"/>
                                    <field name="ac" widget="boolean_toggle" string="Aire acondicionado"/>
                                </group>
                                <group string="Interior">
                                    <field name="furnished" widget="boolean_toggle"/>
                                </group>
                            </group>
                        </page>
                        
                        <page string="Descripción" name="description">
                            <field name="description" widget="html" placeholder="Describe el inmueble..."/>
                        </page>
                        
                        <page string="Propietario" name="contacts">
                            <group>
                                <group>
                                    <field name="owner_id"/>
                                </group>
                                <group invisible="state not in ['rented', 'sold']">
                                    <field name="tenant_id" string="Cliente"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================== -->
    <!-- VISTA KANBAN                                  -->
    <!-- ============================================== -->
    <record id="view_property_kanban" model="ir.ui.view">
        <field name="name">real.estate.property.kanban</field>
        <field name="model">real.estate.property</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false" sample="1">
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill">
                            <div class="o_kanban_image" style="width: 130px;">
                                <field name="image_1920" widget="image" options="{'size': [130, 130]}"/>
                            </div>
                            
                            <div class="oe_kanban_details d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <small class="text-muted">#<field name="reference"/></small>
                                    <field name="state" widget="label_selection" 
                                           options="{'classes': {'draft': 'secondary', 'available': 'success', 'reserved': 'warning', 'sold': 'danger', 'rented': 'info'}}"/>
                                </div>
                                
                                <strong class="o_kanban_record_title text-truncate mb-1">
                                    <field name="name"/>
                                </strong>
                                
                                <small class="text-muted mb-1">
                                    <field name="property_type_id"/> · <field name="operation_type"/>
                                </small>
                                
                                <div class="text-muted small mb-2">
                                    <i class="fa fa-map-marker text-danger"/> <field name="city"/>
                                </div>
                                
                                <div class="d-flex gap-2 small mb-2">
                                    <span><strong><field name="surface"/></strong> m²</span>
                                    <span><strong><field name="rooms"/></strong> hab</span>
                                    <span><strong><field name="bathrooms"/></strong> baños</span>
                                </div>
                                
                                <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center">
                                    <strong class="text-primary">
                                        <field name="sale_price"/> €
                                    </strong>
                                    <field name="agent_id" widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================================== -->
    <!-- VISTA SEARCH                                  -->
    <!-- ============================================== -->
    <record id="view_property_search" model="ir.ui.view">
        <field name="name">real.estate.property.search</field>
        <field name="model">real.estate.property</field>
        <field name="arch" type="xml">
            <search string="Buscar Propiedades">
                <field name="name" string="Buscar" filter_domain="['|', '|', ('name', 'ilike', self), ('reference', 'ilike', self), ('city', 'ilike', self)]"/>
                <field name="property_type_id"/>
                <field name="city"/>
                <field name="agent_id"/>
                <separator/>
                <filter string="Disponibles" name="available" domain="[('state', '=', 'available')]"/>
                <filter string="Reservadas" name="reserved" domain="[('state', '=', 'reserved')]"/>
                <filter string="Vendidas" name="sold" domain="[('state', '=', 'sold')]"/>
                <filter string="Alquiladas" name="rented" domain="[('state', '=', 'rented')]"/>
                <separator/>
                <filter string="En Venta" name="for_sale" domain="[('operation_type', 'in', ['sale', 'both'])]"/>
                <filter string="En Alquiler" name="for_rent" domain="[('operation_type', 'in', ['rent', 'both'])]"/>
                <separator/>
                <filter string="Con Garaje" name="garage" domain="[('garage', '=', True)]"/>
                <filter string="Con Piscina" name="pool" domain="[('piscina', '=', True)]"/>
                <filter string="Amueblado" name="furnished" domain="[('furnished', '=', True)]"/>
                <separator/>
                <filter string="Mis Propiedades" name="my_properties" domain="[('agent_id', '=', uid)]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Tipo" name="group_type" context="{'group_by': 'property_type_id'}"/>
                    <filter string="Ciudad" name="group_city" context="{'group_by': 'city'}"/>
                    <filter string="Agente" name="group_agent" context="{'group_by': 'agent_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================== -->
    <!-- ACCIÓN                                        -->
    <!-- ============================================== -->
    <record id="action_property" model="ir.actions.act_window">
        <field name="name">Propiedades</field>
        <field name="res_model">real.estate.property</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_available': 1}</field>
        <field name="search_view_id" ref="view_property_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ¡Publica tu primera propiedad!
            </p>
        </field>
    </record>

</odoo>