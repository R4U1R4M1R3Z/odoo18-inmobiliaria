            <field name="garden">1</field>
            <field name="operation_type">sale</field>
            <field name="sale_price">350000</field>
            <field name="state">available</field>
        </record>

        <!-- Propiedad de ejemplo 3 - Alquiler -->
        <record id="property_demo_3" model="real.estate.property">
            <field name="name">Apartamento amueblado centro</field>
            <field name="property_type_id" ref="property_type_apartment"/>
            <field name="street">Calle Colón, 8</field>
            <field name="city">Valencia</field>
            <field name="zip">46004</field>
            <field name="surface">65</field>
            <field name="rooms">2</field>
            <field name="bathrooms">1</field>
            <field name="floor">2</field>
            <field name="elevator">1</field>
            <field name="furnished">1</field>
